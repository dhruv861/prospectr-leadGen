generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  partner
}

enum WebsiteStatus {
  none
  instagram_only
  has_website
}

enum LeadStatus {
  new
  contacted
  interested
  quoted
  won
  lost
}

enum ScrapeRunStatus {
  running
  succeeded
  failed
}

enum ApifyAccountStatus {
  active
  exhausted
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String      @map("password_hash")
  role         UserRole
  scrapeRuns   ScrapeRun[]
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@map("users")
}

model ApifyAccount {
  id               String              @id @default(uuid())
  label            String
  tokenEnvVar      String              @unique @map("token_env_var")
  monthlyBudgetUsd Decimal             @default(5.00) @db.Decimal(10, 2) @map("monthly_budget_usd")
  usedThisCycleUsd Decimal             @default(0) @db.Decimal(10, 2) @map("used_this_cycle_usd")
  cycleResetDate   DateTime            @db.Date @map("cycle_reset_date")
  status           ApifyAccountStatus  @default(active)
  scrapeRuns       ScrapeRun[]
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@map("apify_accounts")
}

model ScrapeRun {
  id               String          @id @default(uuid())
  searchTerm       String          @map("search_term")
  locality         String
  requestedById    String          @map("requested_by")
  requestedBy      User            @relation(fields: [requestedById], references: [id])
  apifyAccountId   String          @map("apify_account_id")
  apifyAccount     ApifyAccount    @relation(fields: [apifyAccountId], references: [id])
  apifyRunId       String          @map("apify_run_id")
  placesReturned   Int?            @map("places_returned")
  estimatedCostUsd Decimal?        @db.Decimal(10, 4) @map("estimated_cost_usd")
  status           ScrapeRunStatus @default(running)
  startedAt        DateTime        @default(now()) @map("started_at")
  finishedAt       DateTime?       @map("finished_at")
  leads            Lead[]

  @@index([searchTerm, locality, status, finishedAt], map: "idx_scraperun_cooldown")
  @@map("scrape_runs")
}

model Lead {
  id              String        @id @default(uuid())
  placeId         String        @unique @map("place_id")
  businessName    String        @map("business_name")
  category        String?
  phone           String?
  address         String
  locality        String
  websiteStatus   WebsiteStatus @default(none) @map("website_status")
  websiteUrl      String?       @map("website_url")
  rating          Float?
  reviewCount     Int?          @map("review_count")
  mapsUrl         String        @map("maps_url")
  sourceRunId     String        @map("source_run_id")
  sourceRun       ScrapeRun     @relation(fields: [sourceRunId], references: [id])
  status          LeadStatus    @default(new)
  notes           String?
  lastContactedAt DateTime?     @map("last_contacted_at")
  shortlistedAt   DateTime?     @map("shortlisted_at")
  followUpAt      DateTime?     @map("follow_up_at")
  pitchIdeas              Json?     @map("pitch_ideas")
  pitchIdeasGeneratedAt   DateTime? @map("pitch_ideas_generated_at")
  opportunities            Json?     @map("opportunities")
  opportunitiesGeneratedAt DateTime? @map("opportunities_generated_at")
  reviewPainPoints            Json?     @map("review_pain_points")
  reviewPainPointsGeneratedAt DateTime? @map("review_pain_points_generated_at")
  competitorGaps            Json?     @map("competitor_gaps")
  competitorGapsGeneratedAt DateTime? @map("competitor_gaps_generated_at")
  whatsappOpener            String?   @map("whatsapp_opener")
  whatsappOpenerGeneratedAt DateTime? @map("whatsapp_opener_generated_at")
  rawData         Json          @map("raw_data")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([locality, category, status], map: "idx_lead_filter")
  @@index([websiteStatus], map: "idx_lead_website_status")
  @@index([shortlistedAt], map: "idx_lead_shortlisted")
  @@index([followUpAt], map: "idx_lead_followup")
  @@map("leads")
}
