# Neon Postgres — pooled connection (used by the app at runtime)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true&connect_timeout=15"
# Neon Postgres — direct/unpooled connection (used by `prisma migrate`)
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"

# NextAuth / Auth.js
# Generate with: npx auth secret   (or) openssl rand -base64 32
AUTH_SECRET=""

# Seed accounts (used only by `npm run seed`, never hardcoded)
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
PARTNER_NAME="Partner"
PARTNER_EMAIL="partner@example.com"
PARTNER_PASSWORD="change-me"

# Apify — rotating account tokens. Add more APIFY_TOKEN_n vars to grow the pool;
# prisma/seed.ts picks up any APIFY_TOKEN_\d+ var automatically.
APIFY_TOKEN_1=""
APIFY_TOKEN_2=""
APIFY_TOKEN_3=""

# Apify actor + cost controls
APIFY_ACTOR_ID="compass/crawler-google-places"
APIFY_MAX_PLACES_PER_SEARCH="50"

# Cooldown window (days) before a repeat search+locality triggers a new scrape
SCRAPE_COOLDOWN_DAYS="30"
